# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_SECRET: Owner secret required to approve MTN MoMo payments, generate single-use redeem codes, and register WireGuard servers.
ADMIN_SECRET="CHANGE_ME_STRONG_ADMIN_SECRET"

# SESSION_SECRET: HMAC key used to sign backend session tokens.
SESSION_SECRET="CHANGE_ME_RANDOM_SESSION_SECRET"

# PAYMENT_WEBHOOK_SECRET: Optional HMAC-SHA256 secret for automated MTN MoMo / payment gateway webhooks.
PAYMENT_WEBHOOK_SECRET="CHANGE_ME_WEBHOOK_SECRET"
